# Supabase (seguro expor no cliente — RLS e as Edge Functions protegem os dados)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segredos das Edge Functions (NUNCA prefixar com VITE_). Configurar via
# `npx supabase secrets set`, não aqui:
#   PAGAMENTO_PROVEDOR=simulado      (na fase do Asaas: asaas)
#   ASAAS_API_KEY=                   (fase do Asaas)
